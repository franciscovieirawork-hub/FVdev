---
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';
import Loader from '../components/Loader.astro';
import { cv, cvPdfPath, cvPdfFilename } from '../data/cv';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico">
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>CV - Francisco Vieira</title>
    <meta name="description" content="Curriculum vitae of Francisco Vieira" />
    <ViewTransitions />
  </head>
  <body>
    <Loader />
    <main>
      <div class="container">
        <div class="top-bar no-print">
          <a href="/" class="back-btn">← back</a>
          <a href={cvPdfPath} class="download-btn" download={cvPdfFilename}>
            download pdf
          </a>
        </div>

        <header class="cv-header">
          <h1>{cv.name}</h1>
          <p class="role">{cv.title}</p>
          <p class="meta">{cv.location} · {cv.phone} · {cv.email}</p>
          <p class="meta links">
            <a href={cv.website} target="_blank" rel="noopener noreferrer">website</a>
            ·
            <a href={cv.linkedin} target="_blank" rel="noopener noreferrer">linkedin</a>
            ·
            <a href={cv.github} target="_blank" rel="noopener noreferrer">github</a>
          </p>
        </header>

        <section>
          <h2>summary</h2>
          <p>{cv.summary}</p>
        </section>

        <section>
          <h2>skills</h2>
          <p class="skills">{cv.skills.join(' · ')}</p>
        </section>

        <section>
          <h2>experience</h2>
          {cv.experience.map((job) => (
            <article class="job">
              <div class="job-header">
                <h3>{job.role}</h3>
                <span>{job.dates}</span>
              </div>
              <p class="company">{job.company} · {job.location}</p>
              <ul>
                {job.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            </article>
          ))}
        </section>

        <section>
          <h2>selected projects</h2>
          {cv.projects.map((project) => (
            <article class="project">
              <h3>
                <a href={project.url} target="_blank" rel="noopener noreferrer">{project.name}</a>
              </h3>
              <p>{project.description}</p>
            </article>
          ))}
        </section>
      </div>
    </main>
  </body>
</html>

<style>
  main {
    min-height: 100vh;
    padding: 40px 20px;
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
  }

  .top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 40px;
  }

  .back-btn,
  .download-btn {
    color: #999999;
    text-decoration: none;
    font-size: 0.95rem;
    letter-spacing: 0.01em;
    transition: all 0.2s ease;
    border-bottom: 1px solid transparent;
  }

  .back-btn:hover,
  .download-btn:hover {
    color: #ffff00;
    border-bottom: 1px solid #ffff00;
  }

  .download-btn {
    color: #ffff00;
    border: 2px solid #ffff00;
    border-radius: 4px;
    padding: 8px 16px;
    font-weight: 600;
  }

  .download-btn:hover {
    background-color: #ffff00;
    color: #0f0f0f;
    border-bottom: 2px solid #ffff00;
  }

  .cv-header {
    margin-bottom: 40px;
    padding-bottom: 24px;
    border-bottom: 1px solid #333333;
  }

  h1 {
    font-size: 2.4rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }

  .role {
    color: #ffff00;
    font-size: 1.05rem;
    font-weight: 600;
    margin-bottom: 12px;
  }

  .meta {
    color: #999999;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .links a {
    color: #ffff00;
    text-decoration: none;
  }

  .links a:hover {
    border-bottom: 1px solid #ffff00;
  }

  section {
    margin-bottom: 36px;
  }

  h2 {
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #cccccc;
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid #333333;
  }

  p,
  li {
    color: #e0e0e0;
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .skills {
    color: #cccccc;
  }

  .job,
  .project {
    margin-bottom: 22px;
  }

  .job-header {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  h3 {
    font-size: 1.05rem;
    margin: 0 0 4px 0;
  }

  .job-header span,
  .company {
    color: #999999;
    font-size: 0.9rem;
  }

  ul {
    margin: 10px 0 0 18px;
  }

  .project h3 a {
    color: #ffff00;
    text-decoration: none;
  }

  .project h3 a:hover {
    border-bottom: 1px solid #ffff00;
  }

  @media (max-width: 640px) {
    h1 {
      font-size: 1.8rem;
    }

    .download-btn {
      font-size: 0.85rem;
      padding: 6px 12px;
    }
  }

  @media print {
    body,
    main {
      background: #ffffff;
      color: #111111;
      padding: 0;
    }

    .no-print {
      display: none;
    }

    h1,
    h2,
    h3,
    p,
    li,
    .role,
    .meta,
    .company,
    .skills {
      color: #111111;
    }

    .role,
    .links a,
    .project h3 a {
      color: #111111;
    }

    .cv-header,
    h2 {
      border-color: #cccccc;
    }
  }
</style>
